{
  "name": "vscode-mini-coder",
  "displayName": "Mini-Coder AI 编程助手",
  "description": "AI 编程助手：自动跑测试 + 中文 commit + 错题本归档，支持 BYOK（自带 API key）模式",
  "version": "0.1.0",
  "publisher": "shuxiangke-minicoder",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-name/vscode-mini-coder"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "AI",
    "AI Assistant",
    "LLM",
    "Claude",
    "GPT",
    "DeepSeek",
    "MiniMax",
    "中文",
    "自动测试",
    "中文 commit",
    "错题本"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mini-coder.setApiKey",
        "title": "Mini-Coder: 设置 API Key"
      },
      {
        "command": "mini-coder.openChat",
        "title": "Mini-Coder: 打开聊天面板"
      },
      {
        "command": "mini-coder.runTest",
        "title": "Mini-Coder: 自动跑测试"
      },
      {
        "command": "mini-coder.zhCommit",
        "title": "Mini-Coder: 生成中文 commit"
      },
      {
        "command": "mini-coder.viewNotes",
        "title": "Mini-Coder: 查看今日错题本"
      },
      {
        "command": "mini-coder.restoreSession",
        "title": "Mini-Coder: 恢复历史会话"
      },
      {
        "command": "mini-coder.listSessions",
        "title": "Mini-Coder: 列出历史会话"
      },
      {
        "command": "mini-coder.listNotes",
        "title": "Mini-Coder: 列出错题本归档"
      },
      {
        "command": "mini-coder.doctor",
        "title": "Mini-Coder: 环境自检"
      },
      {
        "command": "mini-coder.copyLogs",
        "title": "Mini-Coder: 复制日志到剪贴板"
      },
      {
        "command": "mini-coder.clearLogs",
        "title": "Mini-Coder: 清空日志"
      },
      {
        "command": "mini-coder.showLogs",
        "title": "Mini-Coder: 显示日志面板"
      }
    ],
    "configuration": {
      "title": "Mini-Coder",
      "properties": {
        "mini-coder.provider": {
          "type": "string",
          "enum": [
            "minimax",
            "deepseek",
            "openai",
            "anthropic",
            "ollama"
          ],
          "default": "deepseek",
          "markdownDescription": "选择 LLM Provider。**注意**：本项优先级低于项目根目录的 `.env`，高于命令面板里保存的选择。"
        },
        "mini-coder.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "模型 ID。留空则用该 Provider 的默认模型（如 `deepseek-chat`）。优先级：`.env` > 本项 > Provider 默认值。"
        },
        "mini-coder.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "覆盖 API 地址。留空则用 Provider 默认值。主要用于切换 MiniMax 国内站（`https://api.minimaxi.com/v1`）/ 国际站（`https://api.minimax.io/v1`）—— 两边账号不通用，key 也互不相认。"
        },
        "mini-coder.autoTestMode": {
          "type": "string",
          "enum": [
            "off",
            "related",
            "all"
          ],
          "enumDescriptions": [
            "关闭：保存文件时完全不自动跑测试",
            "相关测试（推荐）：保存测试文件跑该文件；保存源码时，只跑引用了它的测试",
            "全量：保存任何源码都跑整个项目的测试（慢，但最保险）"
          ],
          "default": "related",
          "markdownDescription": "**自动跑测试**的触发范围。保存文件后自动运行相关测试，失败时提示 AI 修复。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:webview",
    "compile": "tsc",
    "watch": "tsc --watch",
    "build:webview": "cd webview-ui && npm install && npm run build",
    "build:all": "npm run build:webview && npm run compile",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval": "tsc && node out/eval/cli.js",
    "eval:dry": "tsc && node out/eval/cli.js --dry",
    "eval:list": "node out/eval/cli.js --list",
    "eval:verify": "tsc && node out/eval/verifyTasks.js",
    "eval:solvable": "tsc && node out/eval/verifySolvable.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.140.0",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^5.3.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
